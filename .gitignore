# Build outputs — reproducible via wat2wasm / cargo / native/build.sh.
# Exception: examples/**/*.wasm are tracked as runnable distributables.
*.wasm
!examples/**/*.wasm
.air/
native/gen/
native/*-native
air/target/
dist/
*.o
*.cwasm

# Seeded example state — recreated by the example's seed script.
examples/sqlite-tables/data/

# Local credentials and configuration.
.env

# Editor / OS noise
.DS_Store
*~
