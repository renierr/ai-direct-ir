# Build outputs — reproducible via wat2wasm / cargo / native/build.sh.
# Exception: examples/**/*.wasm are tracked as runnable distributables.
*.wasm
!examples/**/*.wasm
native/gen/
native/*-native
host-rs/target/
dist/
libs/**/target/
libs/**/Cargo.lock
*.o
*.cwasm

# Local credentials and configuration.
.env

# Editor / OS noise
.DS_Store
*~
